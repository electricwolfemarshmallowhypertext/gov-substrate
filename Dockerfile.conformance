FROM rust:1.90-slim-bookworm AS builder

WORKDIR /build
COPY runtime-probe/Cargo.toml runtime-probe/Cargo.lock ./
COPY runtime-probe/src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim

COPY --from=builder /build/target/release/gov-runtime-probe /usr/local/bin/gov-runtime-probe

USER 65534:65534

