FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake \
    && CMAKE_ARGS="-DGGML_NATIVE=OFF -DGGML_CPU_ALL_VARIANTS=OFF -DGGML_CUDA=OFF" \
       python -m pip install --no-cache-dir --no-binary=llama-cpp-python \
       llama-cpp-python==0.3.35 'cryptography>=45,<50' \
    && apt-get purge -y --auto-remove build-essential cmake \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY provider_gateway.py google_attestation.py confidential_space_protocol.py \
     confidential_space_worker.py /app/

# The build context must contain exactly one separately SHA-256-verified pinned artifact.
ARG MODEL_FILE
COPY ${MODEL_FILE} /model/${MODEL_FILE}
# Throwaway test transport certificate. Attestation-bound exchange keys, not this
# certificate, are the governed-input confidentiality root.
COPY --chown=65534:65534 --chmod=0400 confidential-test.key /app/tls/key.pem
COPY --chown=65534:65534 --chmod=0444 confidential-test.crt /app/tls/cert.pem
RUN chmod 0700 /app/tls
ENV CONFIDENTIAL_MODEL_PATH=/model/${MODEL_FILE} \
    CONFIDENTIAL_TLS_CERT=/app/tls/cert.pem \
    CONFIDENTIAL_TLS_KEY=/app/tls/key.pem \
    PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
EXPOSE 8080/tcp
CMD ["python", "/app/confidential_space_worker.py"]
